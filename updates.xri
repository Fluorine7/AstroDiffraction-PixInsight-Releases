<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>
         <b>AstroDiffraction for PixInsight</b>
      </p>
      <p>Native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.6.0.0001-macos-arm64.zip" sha1="e07ecfe3d29d29567b04c42c2476fffd23277bdc" type="module" releaseDate="20260930134742">
         <title>AstroDiffraction V1.6.0 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL Process. V1.6.0 improves faint/bright spike response and catalog matching, hardens manual star edits, and defers unsolved-image prompts until explicit selection. Includes JWST and Quattro presets next to the module; user presets remain in the system user-data directory. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.6.0.0001-windows-x64.zip" sha1="c2547cf28c2e7b2f341687148161d364e0693fa4" type="module" releaseDate="20260930134742">
         <title>AstroDiffraction V1.6.0 (Windows x64)</title>
         <description>
            <p>Native PCL Process. V1.6.0 improves faint/bright spike response and catalog matching, hardens manual star edits, and defers unsolved-image prompts until explicit selection. Includes JWST and Quattro presets next to the module; user presets remain in the system user-data directory. Requires PixInsight 1.9.5 on Windows x64.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
</xri>
