<?xml version="1.0" encoding="utf-8"?>
<xri version="1.0">
   <description>
      <p>AstroDiffraction for PixInsight — native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.7.3.0001-macos-arm64.zip" sha1="18080c736de8131466faa689eb45a75fc5db2b1d" type="module" releaseDate="20261022122551">
         <title>AstroDiffraction V1.7.3 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL Process, build 1.7.3.0001. Fixes Retract Spikes leaving an applied AD step in image history. Retraction now restores the PixInsight history position; regeneration replaces the undone branch while preserving earlier processing. Guards against intervening image or history changes. Retains V1.7.2 sampling precision and optical performance improvements; includes complete user documentation and third-party licenses.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.7.3.0001-windows-x64.zip" sha1="7b772f68db7c3dac0f8aa64205d8919d87ddbb5b" type="module" releaseDate="20261022154158">
         <title>AstroDiffraction V1.7.3 (Windows x64)</title>
         <description>
            <p>Native PCL Process, build 1.7.3.0001. Fixes Retract Spikes leaving an applied AD step in image history. Retraction now restores the PixInsight history position; regeneration replaces the undone branch while preserving earlier processing. Guards against intervening image or history changes. Includes V1.7.2 large-kernel and far-field sampling precision and optical performance improvements, SDK security backports, complete user documentation and third-party licenses.</p>
            <p>Compiled on Windows and separately signed on macOS with the Fluorine7 CPD identity. Installed under Process &gt; Convolution &gt; AstroDiffraction. Requires PixInsight 1.9.5 on Windows x64.</p>
         </description>
      </package>
   </platform>
</xri>
