<xri version="1.0">
   <description>
      <p>
         <b>AstroDiffraction for PixInsight</b>
      </p>
      <p>Native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.1.0.0016-macos-arm64.zip" sha1="85a703de571957fb3bf8e2482c3d069c76600cc4" type="module" releaseDate="20260925052814">
         <title>AstroDiffraction V1.1 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL C++ Process for generating diffraction spikes. V1.1 improves original/result previews and in-place undo. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.1.0.0016-windows-x64.zip" sha1="0e56ece92fe1d2bb7baf8eba6800faafa3fb062d" type="module" releaseDate="20260925052814">
         <title>AstroDiffraction V1.1 (Windows x64)</title>
         <description>
            <p>Native PCL C++ Process for generating diffraction spikes. V1.1 improves original/result previews and in-place undo. Requires PixInsight 1.9.5 on Windows x64.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
