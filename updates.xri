<xri version="1.0">
   <description>
      <p>
         <b>AstroDiffraction for PixInsight</b>
      </p>
      <p>Native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.2.0.0017-macos-arm64.zip" sha1="b3feb055ce6f7d9b45c9ca8fe017a75fcd4f8b06" type="module" releaseDate="20260925163841">
         <title>AstroDiffraction V1.2 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL C++ Process for generating diffraction spikes. V1.2 improves bright-star detection and spike-wing visibility over bright nebulosity. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.2.0.0017-windows-x64.zip" sha1="0edb4cf9fd1a0b5a419e3e462ac55d4c9094a703" type="module" releaseDate="20260925163841">
         <title>AstroDiffraction V1.2 (Windows x64)</title>
         <description>
            <p>Native PCL C++ Process for generating diffraction spikes. V1.2 improves bright-star detection and spike-wing visibility over bright nebulosity. Requires PixInsight 1.9.5 on Windows x64.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
