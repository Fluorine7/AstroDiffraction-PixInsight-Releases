<xri version="1.0">
   <description>
      <p>
         <b>AstroDiffraction for PixInsight</b>
      </p>
      <p>Native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.5.2.0001-macos-arm64.zip" sha1="298fc4941933a871434cedacb1fa5f3cfa39b92d" type="module" releaseDate="20260928163747">
         <title>AstroDiffraction V1.5.2 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL Process with catalog-assisted and image-only star detection, improved sharp-star spike visibility, JWST reticle optical preset, and reduced peak memory use. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.5.2.0001-windows-x64.zip" sha1="3ed9c6682a94d6c6b504f83e0f1aa3143baf90a4" type="module" releaseDate="20260928163747">
         <title>AstroDiffraction V1.5.2 (Windows x64)</title>
         <description>
            <p>Native PCL Process with catalog-assisted and image-only star detection, improved sharp-star spike visibility, JWST reticle optical preset, and reduced peak memory use. Requires PixInsight 1.9.5 on Windows x64.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
