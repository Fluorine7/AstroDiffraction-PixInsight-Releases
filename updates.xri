   <description>
      <p>
         <b>AstroDiffraction for PixInsight</b>
      </p>
      <p>Native diffraction-spike Process by Fluorine Zhu.</p>
      <p>Source: https://github.com/Fluorine7/AstroDiffraction-PixInsight</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.0.0.0015-macos-arm64.zip" sha1="9aa3eb6a3acf7426d589a174302e20082a901b51" type="module" releaseDate="20260924112600">
         <title>AstroDiffraction V1.0 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL C++ Process for generating diffraction spikes. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
