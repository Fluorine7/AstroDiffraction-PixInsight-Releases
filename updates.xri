<?xml version="1.0" encoding="utf-8"?>
<xri version="1.0">
   <description>
      <p>AstroDiffraction for PixInsight — native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.7.4.0001-macos-arm64.zip" sha1="4f61124dfdb4f90c07d51eeab82d0f3de50f9a89" type="module" releaseDate="20261022161111">
         <title>AstroDiffraction V1.7.4 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL Process, build 1.7.4.0001. Adds a permanent framed reminder below the top command bar: use AstroDiffraction after color balance and BXT, before stretching, while the image is still linear. The reminder stays visible across parameter pages and scrolling, with bold key conditions and wrapping text.</p>
            <p>Retains V1.7.3 history retraction and V1.7.2 sampling and performance improvements. Includes complete user documentation and third-party licenses. Installed under Process &gt; Convolution &gt; AstroDiffraction. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.7.4.0001-windows-x64.zip" sha1="c10cfbf2c8cd9adf03e6765cf83090eec00976ff" type="module" releaseDate="20261022162744">
         <title>AstroDiffraction V1.7.4 (Windows x64)</title>
         <description>
            <p>Native PCL Process, build 1.7.4.0001. Adds a permanent framed reminder below the top command bar: use AstroDiffraction after color balance and BXT, before stretching, while the image is still linear. The reminder stays visible across parameter pages and scrolling, with bold key conditions and wrapping text.</p>
            <p>Compiled on Windows and separately signed on macOS with the Fluorine7 CPD identity. Retains V1.7.3 history retraction and V1.7.2 sampling and performance improvements. Includes complete user documentation and third-party licenses. Installed under Process &gt; Convolution &gt; AstroDiffraction. Requires PixInsight 1.9.5 on Windows x64.</p>
         </description>
      </package>
   </platform>
</xri>
