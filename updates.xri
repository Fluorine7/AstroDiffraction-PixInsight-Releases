<?xml version="1.0" encoding="utf-8"?>
<xri version="1.0">
   <description>
      <p>AstroDiffraction for PixInsight — native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.7.2.0001-macos-arm64.zip" sha1="513bb76aa3ec5211604f6af90cef3ccd82bcf4b3" type="module" releaseDate="20261022114548">
         <title>AstroDiffraction V1.7.2 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL Process, build 1.7.2.0001. Improves large-kernel and far-field sampling with factor-2 intensity grids, Lanczos-16 detector integration and an earlier blend between fields. Accelerates first optical builds with bounded parallelism while preserving the corrected sampling precision. Fixes catalog cancellation and photometry bounds; includes complete user documentation and third-party licenses.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.7.1.0002-windows-x64-r2.zip" sha1="40d2c7b41ecb5d1a0cb63d701daa0d02a1951d4e" type="module" releaseDate="20261022085148">
         <title>AstroDiffraction V1.7.1 (Windows x64, signature r2)</title>
         <description>
            <p>Signature revision r2: reissues the unchanged 1.7.1.0002 DLL with a separately generated Fluorine7 CPD signature, independently verified with the public key from Windows PixInsight. Replaces the original Windows package whose module signature was invalid.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction. Requires PixInsight 1.9.5 on Windows x64.</p>
         </description>
      </package>
   </platform>
</xri>
