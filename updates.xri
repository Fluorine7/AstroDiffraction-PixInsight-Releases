<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>
         <b>AstroDiffraction for PixInsight</b>
      </p>
      <p>Native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.5.3.0001-macos-arm64.zip" sha1="10d2d6f4081a0f6d866810a7992dcb2ec908f56c" type="module" releaseDate="20260928170737">
         <title>AstroDiffraction V1.5.3 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL Process. V1.5.3 installs a preset pack next to the module, adds automatic loading of supplied JWST and Quattro optics presets, and preserves user presets in the system user-data directory. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.5.3.0001-windows-x64.zip" sha1="3be3f3198c432a3c72738d9875765200a103fc99" type="module" releaseDate="20260928170737">
         <title>AstroDiffraction V1.5.3 (Windows x64)</title>
         <description>
            <p>Native PCL Process. V1.5.3 installs a preset pack next to the module, adds automatic loading of supplied JWST and Quattro optics presets, and preserves user presets in the system user-data directory. Requires PixInsight 1.9.5 on Windows x64.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
</xri>
