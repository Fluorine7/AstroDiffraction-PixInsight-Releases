<xri version="1.0">
   <description>
      <p>
         <b>AstroDiffraction for PixInsight</b>
      </p>
      <p>Native diffraction-spike Process by Fluorine Zhu.</p>
   </description>
   <platform os="macosx" arch="arm64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.3.0.0018-macos-arm64.zip" sha1="cccd67738597d448e53662d50dc60fd3eb044e4d" type="module" releaseDate="20260926141823">
         <title>AstroDiffraction V1.3 (macOS Apple Silicon)</title>
         <description>
            <p>Native PCL C++ Process for generating diffraction spikes. V1.3 improves manual-star brightness, very bright stars, and core sharpness with broader spikes. Requires PixInsight 1.9.5 and macOS 14 or later.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.5:1.9.5">
      <package fileName="AstroDiffraction-1.3.0.0018-windows-x64.zip" sha1="16413762cee5643587b4b402ad1538467c3ff068" type="module" releaseDate="20260926141823">
         <title>AstroDiffraction V1.3 (Windows x64)</title>
         <description>
            <p>Native PCL C++ Process for generating diffraction spikes. V1.3 improves manual-star brightness, very bright stars, and core sharpness with broader spikes. Requires PixInsight 1.9.5 on Windows x64.</p>
            <p>Installed under Process &gt; Convolution &gt; AstroDiffraction.</p>
         </description>
      </package>
   </platform>
</xri>
